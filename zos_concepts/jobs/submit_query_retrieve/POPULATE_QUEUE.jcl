//MQPUT01  JOB (ACCT),'POPULATE MQ',CLASS=A,MSGCLASS=X
//*
//* Popola DEMO.SORGENTE.QUEUE su CSQ9
//*
//STEP1    EXEC PGM=CSQUTIL
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
COMMAND DDNAME(CMD)
/*
//CMD      DD *
CONNECT QMGR(CSQ9)
PUT QNAME(DEMO.SORGENTE.QUEUE) MSG('Primo messaggio di test')
PUT QNAME(DEMO.SORGENTE.QUEUE) MSG('Secondo messaggio di test')
PUT QNAME(DEMO.SORGENTE.QUEUE) MSG('Terzo messaggio di test')
PUT QNAME(DEMO.SORGENTE.QUEUE) MSG('Quarto messaggio di test')
PUT QNAME(DEMO.SORGENTE.QUEUE) MSG('Quinto messaggio di test')
DISCONNECT
/*
